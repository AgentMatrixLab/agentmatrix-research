    "($volume-Mean($volume,20))/Std($volume,20)",
    "Rank($close)",
    "Sum(Log($close),20)",
    "Max($high,20)/$close-1",
    "Min($low,20)/$close-1",
    "($close-$open)/$open",
    "($vwap-$close)/$close",
    "($close-Ref($close,10))/Std($close,10)",
    "Delta(Log($volume),20)",
    "Sum($volume,20)/Sum($volume,60)-1",
    "Corr($close,Ref($close,20),20)",
    "$close/Mean($close,60)",
    "Std($volume,20)/Mean($volume,20)",
