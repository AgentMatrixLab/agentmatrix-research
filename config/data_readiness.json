{
  "schema_version": 1,
  "data_version_source": "daily_kline",
  "datasets": [
    {
      "id": "daily_kline",
      "glob": "kline_daily/kline_*.parquet",
      "required_columns": ["symbol", "trade_date", "open", "high", "low", "close", "volume", "amount"],
      "date_column": "trade_date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "st_status",
      "glob": "st_status/st_status_*.parquet",
      "required_columns": ["symbol", "trade_date", "is_st"],
      "date_column": "trade_date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "shares_daily",
      "glob": "shares_daily/shares_*.parquet",
      "required_columns": ["symbol", "trade_date", "market_cap", "total", "circulation_a", "free_circulation"],
      "date_column": "trade_date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "daily_factors",
      "glob": "daily_factors/daily_factors_*.parquet",
      "required_columns": ["symbol", "trade_date", "pe_ratio", "pb_ratio", "ps_ratio", "turnover_rate"],
      "date_column": "trade_date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "ex_factor",
      "glob": "ex_factor/ex_factor_*.parquet",
      "required_columns": ["symbol", "ex_date", "ex_cum_factor", "ex_factor"],
      "date_column": "ex_date",
      "freshness": "max_age_days",
      "max_age_days": 45,
      "required": true
    },
    {
      "id": "index_kline",
      "glob": "index_kline/index_daily.parquet",
      "required_columns": ["order_book_id", "date", "close"],
      "date_column": "date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "financial_income",
      "glob": "financials/income_2010_*.parquet",
      "required_columns": ["order_book_id", "quarter", "info_date", "net_profit", "revenue"],
      "date_column": "info_date",
      "freshness": "max_age_days",
      "max_age_days": 300,
      "required": true
    },
    {
      "id": "financial_balance",
      "glob": "financials/balance_2010_*.parquet",
      "required_columns": ["order_book_id", "quarter", "info_date", "total_assets", "total_liabilities"],
      "date_column": "info_date",
      "freshness": "max_age_days",
      "max_age_days": 300,
      "required": true
    },
    {
      "id": "engine_adjusted_kline",
      "glob": "strategy_inputs/adjusted_kline_*.parquet",
      "required_columns": ["symbol", "trade_date", "open", "high", "low", "close", "open_adj", "high_adj", "low_adj", "close_adj", "volume", "amount", "limit_up", "limit_down"],
      "date_column": "trade_date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "engine_suspension_status",
      "glob": "strategy_inputs/suspension_status_*.parquet",
      "required_columns": ["symbol", "trade_date", "is_suspended"],
      "date_column": "trade_date",
      "freshness": "data_version",
      "required": true
    },
    {
      "id": "dividend_yield",
      "glob": "strategy_inputs/dividend_yield_*.parquet",
      "required_columns": ["symbol", "date", "dividend_yield"],
      "date_column": "date",
      "freshness": "max_age_days",
      "max_age_days": 10,
      "required": true
    }
  ]
}
