# ---- Factor Lab Supabase integration (truth compare / dashboard sync) ----
# Project public URL, for example https://<project-ref>.supabase.co
FACTOR_LAB_SUPABASE_URL=

# service_role key for trusted backend/local scripts only. It must be able to
# read factor_truth_values and write factor_truth_comparisons/public dashboard
# rows. Never commit real keys; .env is ignored by git.
FACTOR_LAB_SUPABASE_WRITE_KEY=

# ---- Alpha158 / SmartData ClickHouse integration ----
# Copy to .env and fill in credentials. Never commit .env.
SMARTDATA_CH_HOST=127.0.0.1
SMARTDATA_CH_PORT=19000
SMARTDATA_CH_USER=smartdata_ro
SMARTDATA_CH_PASSWORD=
SMARTDATA_CH_DATABASE=amazingdata
